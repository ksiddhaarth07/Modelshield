# ModelShield public frontend endpoints (copy to .env.local for local dev).
# SECURITY: Never store API keys, AWS credentials, or bearer tokens in VITE_*
# variables; Vite embeds all VITE_* values directly into the public JS bundle.
VITE_V1_API_URL=https://your-v1-api-id.execute-api.ap-southeast-2.amazonaws.com
VITE_V2_API_URL=https://your-v2-api-id.execute-api.ap-southeast-2.amazonaws.com
# Public Cognito SPA identifiers (safe for frontend bundles; never add client secrets).
VITE_COGNITO_REGION=ap-southeast-2
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
